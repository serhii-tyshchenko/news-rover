{
  "name": "news-rover",
  "version": "1.0.0",
  "private": false,
  "description": "A React application for reading news from various sources using RSS feeds. It features a responsive design, themes, and supports multiple languages.",
  "homepage": "https://news-rover.netlify.app/",
  "keywords": [
    "news",
    "rss",
    "react",
    "redux",
    "vite",
    "typescript"
  ],
  "author": {
    "name": "Serhii Tyshchenko",
    "url": "https://github.com/serhii-tyshchenko"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/serhii-tyshchenko/news-rover"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.100.6",
    "@types/node": "^22.7.6",
    "@types/react": "^19.2.14",
    "@types/react-router": "^5.1.20",
    "@vitejs/plugin-react": "^6.0.2",
    "focus-trap-react": "^12.0.1",
    "lodash-es": "^4.17.21",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-redux": "^9.2.0",
    "react-router": "^8.3.0",
    "redux": "^5.0.1",
    "sass": "^1.80.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.2.0",
    "jsdom": "^29.0.1",
    "prettier": "3.5.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  },
  "imports": {
    "#api": "./src/api/index.ts",
    "#api/*": "./src/api/*/index.ts",
    "#assets": "./src/assets/index.ts",
    "#assets/*": "./src/assets/*/index.ts",
    "#components": "./src/components/index.ts",
    "#components/*": "./src/components/*/index.ts",
    "#constants": "./src/constants/index.ts",
    "#contexts": "./src/contexts/index.ts",
    "#hooks": "./src/hooks/index.ts",
    "#layout": "./src/layout/index.ts",
    "#pages": "./src/pages/index.ts",
    "#queries": "./src/queries/index.ts",
    "#storage": "./src/storage/index.ts",
    "#storage/*": "./src/storage/*/index.ts",
    "#store": "./src/store/index.ts",
    "#store/*": "./src/store/*/index.ts",
    "#styles": "./src/styles/index.ts",
    "#styles/*": "./src/styles/*/index.ts",
    "#types": "./src/types/index.ts",
    "#utils": "./src/utils/index.ts",
    "#utils/*": "./src/utils/*/index.ts"
  }
}
